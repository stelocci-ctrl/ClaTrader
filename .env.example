# ---------- Bybit ----------
# Crea la chiave API su Bybit: permessi "Read-Write" solo per Contratti/Spot (Trade),
# MAI il permesso di prelievo (Withdraw). Limita la chiave al tuo IP se possibile.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = testnet.bybit.com (consigliato per iniziare), false = conto reale
BYBIT_TESTNET=true
# linear = perpetual USDT (long e short) | spot = solo long
BYBIT_CATEGORY=linear
SYMBOLS=BTCUSDT,ETHUSDT
LEVERAGE=1

# ---------- Telegram ----------
# Token da @BotFather, chat id da @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Strategia ----------
INTERVAL=15
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=200
RSI_PERIOD=14
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
ATR_PERIOD=14
ATR_SL_MULT=1.5
REWARD_RISK=2.0
# Filtro volume: candela del segnale >= VOLUME_MULT x media degli ultimi VOLUME_PERIOD volumi (0 = disattivato)
VOLUME_PERIOD=20
VOLUME_MULT=1.5

# ---------- Rischio / esecuzione ----------
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_USDT=1000
APPROVAL_TIMEOUT_SEC=300
MAX_PRICE_DEVIATION_PCT=0.5
POLL_INTERVAL_SEC=60
# true = autorizzi ma nessun ordine viene inviato. Metti false solo dopo aver testato.
DRY_RUN=true
