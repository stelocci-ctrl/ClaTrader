# ---------- Exchange ----------
# okx = OKX (consigliato in Europa: OKX Europe, licenza MiCA) | bybit = Bybit
EXCHANGE=okx
# eu = sito europeo (OKX: eea.okx.com / my.okx.com, Bybit: bybit.eu) | global = sito internazionale
REGION=eu
# true = conto di prova (OKX Demo Trading / Bybit testnet), false = CONTO REALE
TESTNET=true
# Coppie da analizzare. In Europa niente USDT (MiCA): usa USDC o EUR, es. BTCUSDC,ETHUSDC
SYMBOLS=BTCUSDC,ETHUSDC

# ---------- OKX ----------
# Chiavi create DENTRO la Demo Trading se TESTNET=true (quelle del conto reale non funzionano).
# Permessi: Read + Trade. MAI Withdraw. La passphrase è quella scelta creando la chiave.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---------- Bybit (solo se EXCHANGE=bybit) ----------
# Permessi "Read-Write" solo per Contratti/Spot (Trade), MAI Withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# linear = perpetual USDT (long e short) | spot = solo long. Bybit EU offre solo spot.
CATEGORY=spot
LEVERAGE=1

# ---------- Telegram ----------
# Token da @BotFather, chat id da @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Strategia ----------
# ema = incrocio di medie (intraday) | breakout = trend following su candele giornaliere
STRATEGY=breakout
# Breakout: entrata sopra il massimo di N giorni, uscita AUTOMATICA sotto il minimo di M giorni
BREAKOUT_ENTRY_DAYS=20
BREAKOUT_EXIT_DAYS=10
BREAKOUT_ATR_PERIOD=20
BREAKOUT_STOP_ATR=2
# Parametri della strategia "ema" (ignorati con STRATEGY=breakout; INTERVAL è sempre D per il breakout)
INTERVAL=15
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=200
RSI_PERIOD=14
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
ATR_PERIOD=14
ATR_SL_MULT=1.5
REWARD_RISK=2.0
# Filtro volume: candela del segnale >= VOLUME_MULT x media degli ultimi VOLUME_PERIOD volumi (0 = disattivato)
VOLUME_PERIOD=20
VOLUME_MULT=1.5

# ---------- Rischio / esecuzione ----------
RISK_PER_TRADE_PCT=1.0
# Valore massimo di una posizione, nella valuta della coppia (USDT, USDC, EUR...)
MAX_POSITION_USDT=1000
APPROVAL_TIMEOUT_SEC=300
MAX_PRICE_DEVIATION_PCT=0.5
POLL_INTERVAL_SEC=60
# true = autorizzi ma nessun ordine viene inviato. Metti false solo dopo aver testato.
DRY_RUN=true
